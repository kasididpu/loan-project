{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git restore:*)",
      "Bash(docker manifest inspect:*)",
      "PowerShell(git status:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git log:*)",
      "PowerShell(git show:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git switch:*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git restore:*)",
      "PowerShell(docker manifest inspect:*)"
    ],
    "deny": [
      "Bash(dotnet:*)",
      "Bash(docker run:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker exec:*)",
      "Bash(docker start:*)",
      "Bash(docker stop:*)",
      "Bash(docker rm:*)",
      "Bash(docker rmi:*)",
      "Bash(docker pull:*)",
      "Bash(docker push:*)",
      "Bash(stripe:*)",
      "Bash(k6:*)",
      "Bash(vault:*)",
      "PowerShell(dotnet:*)",
      "PowerShell(docker run:*)",
      "PowerShell(docker compose:*)",
      "PowerShell(docker build:*)",
      "PowerShell(docker exec:*)",
      "PowerShell(docker start:*)",
      "PowerShell(docker stop:*)",
      "PowerShell(docker rm:*)",
      "PowerShell(docker rmi:*)",
      "PowerShell(docker pull:*)",
      "PowerShell(docker push:*)",
      "PowerShell(stripe:*)",
      "PowerShell(k6:*)",
      "PowerShell(vault:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pfx)",
      "Read(**/*.key)",
      "Read(**/appsettings.*.Local.json)"
    ]
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "stripe@claude-plugins-official": true
  }
}
