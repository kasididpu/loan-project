docs/

# Secret hygiene — secrets live in Vault only, but belt and suspenders
.env
.env.*
*.pfx
*.key
appsettings.*.Local.json

# Local Stripe TEST-MODE keys used to auto-restore the in-memory dev Vault after
# a container restart (see scripts/vault-secrets.local.env.example). The .example
# template is committed; the real filled-in copy never is.
scripts/vault-secrets.local.env
