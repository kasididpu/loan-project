# Copy this file to `vault-secrets.local.env` (same folder) and fill in your
# Stripe TEST-MODE keys. That copy is gitignored and is never committed.
#
# Why this exists: the dev Vault runs in memory, so a container restart wipes
# every secret. scripts/seed-vault-dev.sh sources the copy (when it exists) and
# patches these keys back into Vault on each run, so the Stripe keys survive
# restarts without ever entering the repository.
#
# Format: KEY=value — no spaces around '=', no quotes needed (the keys are
# alphanumeric). Get the webhook signing secret from `stripe listen` (it changes
# each run) or the Stripe Dashboard, matching however you deliver events.

StripeSecretKey=sk_test_replace_me
StripeWebhookSecret=whsec_replace_me
