{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Placeholders only — supplied per environment via the standard config
    // layering: appsettings.Development.json (local default), environment
    // variables (ConnectionStrings__LoanDb, ConnectionStrings__Mongo), later Vault.
    "LoanDb": "",
    "LoanReadDb": "",
    "Mongo": "",
    "RabbitMq": "",
    "Redis": ""
  },
  "Vault": {
    // Placeholders — real address/auth arrive per environment, never here.
    "Address": "",
    "Token": ""
  },
  "Redpanda": {
    // Placeholder — broker address is per environment (non-secret, but
    // meaningless outside its environment).
    "BootstrapServers": ""
  },
  "Jobs": {
    // Production-shaped defaults: reconcile every 30 minutes, settle at
    // 23:59. Development overrides shorten both so runs are observable.
    "ReconciliationCron": "0 0/30 * * * ?",
    "SettlementCron": "0 59 23 * * ?"
  }
}
