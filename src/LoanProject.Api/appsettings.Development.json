{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Non-secret local dev defaults — match docker-compose.yml. Deploy-path
    // connection strings come from Vault via ISecretProvider (Phase 3.5).
    // TrustServerCertificate: the dev container uses a self-signed cert.
    "LoanDb": "Server=localhost,1433;Database=LoanDb;User Id=sa;Password=LoanDev!Passw0rd;TrustServerCertificate=True",
    // CQRS Read DB — a separate database on the same dev SQL Server (Azure = a
    // separate Azure SQL database). Synced only through projected loan events.
    "LoanReadDb": "Server=localhost,1433;Database=LoanReadDb;User Id=sa;Password=LoanDev!Passw0rd;TrustServerCertificate=True",
    "Mongo": "mongodb://root:LoanDevMongo1@localhost:27017",
    // guest/guest only works from localhost by RabbitMQ's own rules.
    "RabbitMq": "amqp://guest:guest@localhost:5672",
    "Redis": "localhost:6379"
  },
  "Vault": {
    // Dev-mode Vault from docker-compose; the root token is a non-secret
    // local default (real environments authenticate differently — phase 8).
    "Address": "http://localhost:8200",
    "Token": "loan-dev-root"
  },
  "Redpanda": {
    "BootstrapServers": "localhost:9092"
  },
  "Jwt": {
    "Issuer": "loan-api",
    "Audience": "loan-api-clients",
    "AccessTokenMinutes": 60,
    "MfaTokenMinutes": 5
  },
  "Seq": {
    // Local Seq from docker-compose; UI + ingestion at the same address.
    "ServerUrl": "http://localhost:5341"
  },
  "Jobs": {
    // Short cycles so both jobs fire while you watch: reconcile every 5
    // minutes, settle every 10 (production shape is end-of-day only).
    "ReconciliationCron": "0 0/5 * * * ?",
    "SettlementCron": "0 0/10 * * * ?"
  }
}
